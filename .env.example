# ---------- TaskFlow API (backend Spring Boot) ----------
DATABASE_URL=postgresql://taskflow:taskflow@db:5432/taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_DB=taskflow
# mínimo 32 caracteres; gere com: openssl rand -hex 32
JWT_SECRET=
# Login sem Google (POST /auth/dev-login), só para testes locais. Nunca true em produção.
ENABLE_DEV_LOGIN=false

# ---------- App (Expo) ----------
# No emulador/aparelho "localhost" é o próprio aparelho: use o IP da máquina (ex.: http://192.168.0.10:3000)
EXPO_PUBLIC_API_URL=http://localhost:3000

# ---------- Login com Google (direto na API, sem Supabase) ----------
# Crie os OAuth Client IDs no Google Cloud Console (APIs e serviços > Credenciais).
# No app (Expo): um por plataforma
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Na API: os mesmos IDs separados por vírgula; sem eles POST /auth/google responde 503
GOOGLE_CLIENT_IDS=
