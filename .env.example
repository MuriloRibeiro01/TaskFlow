# ---------- TaskFlow API (backend Spring Boot) ----------
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_DB=taskflow
# mínimo 32 caracteres; gere com: openssl rand -hex 32
JWT_SECRET=
# Login só com o e-mail (POST /auth/dev-login e "Entrar sem login" no app), só para testes locais. Nunca true em produção.
ENABLE_DEV_LOGIN=false
# Opcional: priorização com IA. Sem a chave, a API usa o modelo local e as regras por prazo.
ANTHROPIC_API_KEY=

# ---------- App (Expo): copie estas EXPO_PUBLIC_* para app/.env (o Expo não lê o .env da raiz) ----------
# Emulador Android: http://10.0.2.2:3000 · simulador iOS: http://localhost:3000 · celular: http://<IP da máquina>:3000
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
